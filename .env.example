# Copier ce fichier en .env pour surcharger les valeurs par défaut de compose.yaml (.env n'est pas versionné).
# Attention : .env est lu par Docker Compose uniquement. Si vous changez une valeur,
# définissez aussi la variable d'environnement correspondante avant de lancer Spring Boot.
DB_HOST=localhost
DB_PORT=15432
DB_NAME=correspondances
DB_USER=correspondances
DB_PASSWORD=correspondances
